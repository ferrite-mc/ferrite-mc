# Ferrite 서버 설정 예시입니다.
# 이 파일을 실행 디렉터리의 ferrite.toml로 복사한 뒤 값을 수정하세요.
# 모든 키는 생략 가능하며, 생략하면 아래 기본값이 사용됩니다.

# 서버가 접속을 받을 주소 (IP:포트).
bind-address = "0.0.0.0:25565"

# true면 Mojang 인증(정품) 사용, false면 오프라인 모드로 로컬 테스트 가능.
online-mode = true

# 정품 서버에서 서명된 채팅(프로필 키)을 요구합니다.
# 오프라인 모드에서는 항상 무시되고 서명 없는 채팅이 허용됩니다.
enforce-secure-profile = true

# 서버 목록에 표시되는 설명 문구.
motd = "A Ferrite server"

# 서버 목록 아이콘 (64x64 PNG). 파일이 없거나 크기가 다르면 경고만 남기고 아이콘 없이 시작합니다.
server-icon = "server-icon.png"

# 최대 동시 접속자 수.
max-players = 20

# 플레이어에게 전송하는 청크 반경 (2~32로 제한됨).
view-distance = 10

# 허용할 클라이언트 프로토콜 범위.
# "all"은 26.3(777)과 번역 가능한 이전 버전(26.2/776)을 허용하고,
# "native"는 26.3 클라이언트만 허용합니다(허용되지 않는 버전은 로그인 단계에서 끊김).
supported-versions = "all"

# 이 크기(바이트) 이상인 패킷을 압축합니다.
compression-threshold = 256

# 월드 폴더입니다. 상대 경로는 서버 프로세스의 작업 디렉터리 기준이며, 처음 시작할 때
# 생성됩니다. 서버를 이 폴더에서 실행하면 실행 파일 옆에 저장됩니다.
# 정리(clean shutdown) 또는 청크 언로드 때 Anvil 파일(dimensions/minecraft/.../region)이 기록됩니다.
world = "world"

# 월드에 없는 새 청크를 만드는 방법: "superflat"(평지) 또는 "vanilla".
# "vanilla"는 사용자가 받은 공식 서버 jar의 생성기를 별도 JVM 프로세스에서 실행합니다.
# 먼저 python tools/fetch_vanilla.py 와 python tools/build_worldgen_host.py 를 실행하세요.
# 서버는 시작할 때 eula.txt를 확인합니다. Minecraft EULA를 읽고 직접 eula=true로 바꾸세요.
generator = "vanilla"

# 플러그인 브리지 설정입니다.
[plugins]
# 플러그인 이벤트 처리 중 오류(예: JVM 예외)가 발생했을 때의 정책입니다.
# "allow"는 Bukkit처럼 동작을 그대로 진행하고, "deny"는 이벤트가 취소된 것처럼
# 동작을 막은 뒤 블록/텔레포트 상태를 클라이언트에 다시 보냅니다.
on-event-error = "allow"


# 플레이어 정보 전달 방식: "none", "velocity", "bungee".
# 프록시 뒤에서 online-mode 인증은 프록시가 담당하므로 서버의 online-mode는 무시됩니다.
# velocity를 사용할 때는 프록시의 forwarding.secret 값과 forwarding-secret을 맞추세요.
forwarding = "none"
forwarding-secret = ""

# 바닐라 월드 생성 호스트 설정 (generator = "vanilla"일 때). 표는 파일 끝에 둡니다.
# [worldgen]
# heap-mb = 1024
# threads = 8
# jvm-args = []
# seed = "0"
