# Ferrite 서버 설정 예시입니다.
# 이 파일을 실행 디렉터리의 ferrite.toml로 복사한 뒤 값을 수정하세요.
# 모든 키는 생략 가능하며, 생략하면 아래 기본값이 사용됩니다.

# 서버가 접속을 받을 주소 (IP:포트).
bind-address = "0.0.0.0:25565"

# true면 Mojang 인증(정품) 사용, false면 오프라인 모드로 로컬 테스트 가능.
online-mode = true

# 정품 서버에서 서명된 채팅(프로필 키)을 요구합니다.
# 오프라인 모드에서는 항상 무시되고 서명 없는 채팅이 허용됩니다.
enforce-secure-profile = true

# 서버 목록에 표시되는 설명 문구.
motd = "A Ferrite server"

# 서버 목록 아이콘 (64x64 PNG). 파일이 없거나 크기가 다르면 경고만 남기고 아이콘 없이 시작합니다.
server-icon = "server-icon.png"

# 최대 동시 접속자 수.
max-players = 20

# 플레이어에게 전송하는 청크 반경 (2~32로 제한됨).
view-distance = 10

# 이 크기(바이트) 이상인 패킷을 압축합니다. (-1 = 패킷 압축 비활성화, 0 = 모든 패킷 압축)
compression-threshold = 256

# 대형 서버 대역폭 절감을 위한 세밀한 트래픽 압축·배칭 설정 ([network]).
[network]
# zlib 압축 레벨 (1~12: 높을수록 트래픽 감소, 낮을수록 CPU 감소; 기본값 6).
compression-level = 6
# 압축 후 크기가 오히려 커지는 비압축성 페이로드는 무압축 마커(data_length=0)로 전송합니다.
skip-incompressible = true
# 이 바이트 이상 배치에서 압축·암호화를 블로킹 워커로 오프로드합니다.
writer-offload-bytes = 4096
# 소형 패킷을 하나의 TCP 쓰기로 모으는 대기 시간(ms, 0~100; 0이면 즉시 전송).
batch-linger-ms = 2
# 연결당 최대 미압축 송신 대기열 크기(바이트).
send-queue-bytes = 2097152
# 최대 동시 TCP 연결 수 (0 = 무제한).
max-connections = 4096
# IP당 TCP 연결 허용 버스트 및 초당 리필 수 (루프백 제외, 0 = 비활성화).
connection-burst = 20
connection-per-second = 5

# 월드 디렉터리 또는 .fworld 블롭 이름 기준 경로.
# storage = "anvil" 또는 "fworld"일 때 사용됩니다(storage = "memory"에서는 디스크에 월드를 만들지 않습니다).
world = "world"

# 월드에 없는 새 청크를 만드는 방법: "rust"(순수 Rust 병렬 월드젠, 기본값) 또는 "superflat"(평지).
# 먼저 python tools/fetch_vanilla.py 로 바닐라 데이터(vanilla/26.3/generated)를 받아 두세요.
# 서버는 시작할 때 eula.txt를 확인합니다. Minecraft EULA를 읽고 직접 eula=true로 바꾸세요.
generator = "rust"

# 청크 저장 백엔드:
# - "memory": 순수 인메모리 월드 (기본값, 디스크 월드 파일 미생성)
# - "fworld": Ferrite 전용 무결성 검증(xxh32) 단일 압축 블롭(<world>.fworld)으로 RAM에 전체 적재 후 원자적 저장
# - "anvil": 기존 Mojang Anvil 리전 파일(r.<rx>.<rz>.mca)
storage = "memory"

# 청크 압축 방식: "auto"(Anvil=zlib, fworld=lz4), "lz4", "zlib", "gzip", "none".
compression = "auto"

# Tokio 런타임 및 리전 스케줄러 워커 스레드 수 (0 = 시스템 코어 수 자동 사용).
threads = 0

# ferrite-light 병렬 라이팅 워커 풀 사용 여부 (기본값: false).
lighting-pool = false

# 플레이어 정보 전달 방식: "none", "velocity", "bungee".
# 프록시 뒤에서 online-mode 인증은 프록시가 담당하므로 서버의 online-mode는 무시됩니다.
# velocity를 사용할 때는 프록시의 forwarding.secret 값과 forwarding-secret을 맞추세요.
forwarding = "none"
forwarding-secret = ""
whitelist = false

# 순수 Rust 월드젠 시드 설정 ([worldgen]).
[worldgen]
seed = "0"

# 채팅·명령어 속도 제한 (연결마다 토큰 버킷 하나씩). 기본값은 바닐라의 스팸 기준입니다:
# 한 번에 10개, 이후 초당 1개. burst를 0으로 두면 해당 제한이 꺼지고, enabled = false면 둘 다 꺼집니다.
# action은 "kick"(바닐라처럼 "Kicked for spamming"으로 접속 종료) 또는 "drop"(초과 메시지만 버림)입니다.
[rate-limits]
enabled = true
chat-burst = 10
chat-per-second = 1.0
command-burst = 10
command-per-second = 1.0
action = "kick"
